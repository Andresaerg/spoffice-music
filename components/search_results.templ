package components

import "github.com/lmf3z/smlf/cmd/models"

func bestThumbnailURL(t models.Thumbnails) string {
	if t.High != nil && t.High.URL != "" {
		return t.High.URL
	}
	if t.Standard != nil && t.Standard.URL != "" {
		return t.Standard.URL
	}
	return t.Default.URL
}

// SearchResultsList renders the list of YouTube/Invidious search result cards in a YouTube Music style.
templ SearchResultsList(songs []models.YTSong) {
	if len(songs) == 0 {
		<li class="col-span-full flex flex-col items-center justify-center gap-2 rounded-xl border border-white/10 bg-[#181818] p-8 text-center text-slate-400">
			<svg class="size-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
			<span>No se encontraron canciones.</span>
		</li>
	} else {
		for _, song := range songs {
			<li
				data-video-id={ song.VideoID }
				class="group flex flex-col justify-between gap-3.5 rounded-xl border border-white/10 bg-[#181818]/90 p-3.5 shadow-lg shadow-black/30 transition-all duration-200 hover:border-white/20 hover:bg-[#202020]"
			>
				<div>
					<div class="relative aspect-video w-full overflow-hidden rounded-lg bg-black ring-1 ring-white/10">
						<img
							src={ bestThumbnailURL(song.Thumbnails) }
							alt={ "Miniatura de " + song.Title }
							class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
						/>
					</div>
					<h3 class="mt-3 line-clamp-2 text-sm font-semibold text-white group-hover:text-red-400" title={ song.Title }>
						{ song.Title }
					</h3>
					<p class="mt-1 line-clamp-2 text-xs text-slate-400">{ song.Description }</p>
				</div>

				<form class="flex flex-wrap items-center gap-2 pt-1" data-video-id={ song.VideoID }>
					<input type="hidden" name="video_id" value={ song.VideoID }/>
					<input type="hidden" name="title" value={ song.Title }/>
					<input type="hidden" name="description" value={ song.Description }/>
					<input type="hidden" name="thumbnail" value={ song.Thumbnails.Default.URL }/>

					if song.InQueue {
						<button
							disabled
							type="button"
							class="inline-flex cursor-default items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-slate-400"
						>
							<svg class="size-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
							</svg>
							<span>Ya en la cola</span>
						</button>
					} else {
						<button
							type="submit"
							hx-post="/add-to-queue"
							hx-include="closest li"
							hx-target="closest form"
							hx-swap="outerHTML"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-white px-3.5 py-1.5 text-xs font-semibold text-black shadow transition-all hover:bg-slate-200"
							title="Agregar al final de la cola"
						>
							<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"></path>
							</svg>
							<span>En cola</span>
						</button>

						<button
							type="submit"
							hx-post="/add-to-queue?next=true"
							hx-include="closest li"
							hx-target="closest form"
							hx-swap="outerHTML"
							class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3.5 py-1.5 text-xs font-semibold text-white transition-all hover:border-white/30 hover:bg-white/20"
							title="Reproducir inmediatamente después de la canción actual"
						>
							<svg class="size-3.5 shrink-0 text-red-400" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"></path>
							</svg>
							<span>Siguiente</span>
						</button>
					}
				</form>
			</li>
		}
	}
}

// AddedToQueueResponse renders the HTMX form swap + OOB toast when a song is added to the queue.
templ AddedToQueueResponse(queue models.Queue, toastClass, message, badgeText string) {
	<div
		id="toast"
		hx-swap-oob="true"
		class={ toastClass }
		onclick="window.MusicApp?.hideToast ? window.MusicApp.hideToast(this) : (this.style.display='none')"
		x-init="setTimeout(() => { if (window.MusicApp?.hideToast) window.MusicApp.hideToast($el); else $el.style.display = 'none'; }, 3000)"
		title="Toca para cerrar"
	>
		<span>{ message }</span>
		<button type="button" class="ml-2 text-xs font-bold opacity-75 hover:opacity-100">✕</button>
	</div>
	<form class="flex flex-wrap items-center gap-2 pt-1" data-video-id={ queue.VideoID }>
		<input type="hidden" name="video_id" value={ queue.VideoID }/>
		<input type="hidden" name="title" value={ queue.Title }/>
		<input type="hidden" name="description" value={ queue.Description }/>
		<input type="hidden" name="thumbnail" value={ queue.Thumbnail }/>
		<button
			disabled
			type="button"
			class="inline-flex cursor-default items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-400 opacity-90"
		>
			<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
			</svg>
			<span>{ badgeText }</span>
		</button>
	</form>
}
