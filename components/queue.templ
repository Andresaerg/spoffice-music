package components

import (
	"fmt"
	"strconv"

	"github.com/lmf3z/smlf/internal/room"
)

func isTrackPlaying(state room.RoomSnapshot, item room.Track) bool {
	if state.CurrentTrack != nil {
		if item.QueueEntryID > 0 && state.CurrentTrack.QueueEntryID == item.QueueEntryID {
			return true
		}
		if item.ID != "" && state.CurrentTrack.ID == item.ID {
			return true
		}
	}
	return item.EntryStatus == "playing"
}

func trackStatusLabel(state room.RoomSnapshot, item room.Track) string {
	if isTrackPlaying(state, item) {
		if state.Status == room.StatusPaused {
			return "En pausa"
		}
		return "Reproduciendo ahora"
	}
	if item.EntryStatus == "played" {
		return "Reproducida"
	}
	return "A continuación"
}

// QueueItems renders the YouTube Music-style "Up Next" (<li/>) items inside #queue-container.
templ QueueItems(state room.RoomSnapshot) {
	if len(state.Queue) == 0 {
		<li class="flex flex-col items-center justify-center gap-2 px-4 py-10 text-center text-sm text-slate-400">
			<svg class="size-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
			</svg>
			<span>No hay canciones en la cola de hoy.</span>
		</li>
	} else {
		for _, entry := range state.Queue {
			<li
				data-id={ entry.ID }
				data-video-id={ entry.VideoID }
				data-status={ entry.EntryStatus }
				if isTrackPlaying(state, entry) {
					class="group flex items-center justify-between gap-3 bg-white/[0.11] px-3.5 py-2.5 transition-colors hover:bg-white/[0.15]"
				} else if entry.EntryStatus == "played" {
					class="group flex items-center justify-between gap-3 px-3.5 py-2.5 opacity-60 transition-all hover:bg-white/[0.06] hover:opacity-100"
				} else {
					class="group flex items-center justify-between gap-3 px-3.5 py-2.5 transition-colors hover:bg-white/[0.06]"
				}
			>
				<button
					type="button"
					hx-post="/room/play-item"
					hx-vals={ fmt.Sprintf(`{"id": %d}`, entry.QueueEntryID) }
					hx-swap="none"
					if isTrackPlaying(state, entry) {
						aria-current="true"
					}
					class="flex min-w-0 flex-1 cursor-pointer items-center gap-3.5 text-left"
				>
					<!-- YT Music Square Thumbnail with Play / Active Overlay -->
					<span class="relative size-11 shrink-0 overflow-hidden rounded-md bg-black shadow-sm ring-1 ring-white/10">
						<img
							src={ entry.ThumbnailURL }
							alt=""
							class="size-full object-cover"
						/>
						if isTrackPlaying(state, entry) {
							<span class="absolute inset-0 flex items-center justify-center bg-black/65">
								if state.Status == room.StatusPlaying {
									<svg class="size-5 text-white" fill="currentColor" viewBox="0 0 24 24">
										<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path>
									</svg>
								} else {
									<svg class="size-5 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
										<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
									</svg>
								}
							</span>
						} else {
							<span class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity group-hover:opacity-100">
								<svg class="size-5 translate-x-0.5 text-white" fill="currentColor" viewBox="0 0 24 24">
									<path d="M8 5v14l11-7z"></path>
								</svg>
							</span>
						}
					</span>

					<span class="min-w-0 flex-1 overflow-hidden">
						<span
							if isTrackPlaying(state, entry) {
								class="block truncate text-sm font-semibold text-white"
							} else {
								class="block truncate text-sm font-medium text-slate-100 group-hover:text-white"
							}
							title={ entry.Title }
						>
							{ entry.Title }
						</span>
						<span class="mt-0.5 flex items-center gap-1.5 text-xs">
							if isTrackPlaying(state, entry) {
								<span class="font-medium text-red-400">{ trackStatusLabel(state, entry) }</span>
							} else {
								<span class="text-slate-400">{ trackStatusLabel(state, entry) }</span>
							}
						</span>
					</span>
				</button>

				<div class="flex shrink-0 items-center gap-0.5">
					if !isTrackPlaying(state, entry) {
						<button
							type="button"
							hx-post="/room/queue/move-next"
							hx-vals={ fmt.Sprintf(`{"id": %d}`, entry.QueueEntryID) }
							hx-swap="none"
							class="shrink-0 cursor-pointer rounded-full p-1.5 text-slate-400 opacity-75 transition-all group-hover:opacity-100 hover:bg-white/10 hover:text-amber-300 sm:p-2 sm:opacity-0"
							title="Reproducir a continuación (mover justo después de la canción actual)"
							aria-label={ "Reproducir a continuación " + entry.Title }
						>
							<svg class="size-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"></path>
							</svg>
						</button>
					}
					<button
						type="button"
						hx-post="/room/queue/remove"
						hx-vals={ fmt.Sprintf(`{"id": %d}`, entry.QueueEntryID) }
						hx-swap="none"
						class="shrink-0 cursor-pointer rounded-full p-1.5 text-slate-400 opacity-75 transition-all group-hover:opacity-100 hover:bg-white/10 hover:text-red-400 sm:p-2"
						title="Eliminar de la cola"
						aria-label={ "Eliminar " + entry.Title }
					>
						<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</button>
				</div>
			</li>
		}
	}
}

// QueueOOB renders the active playback queue targeted at #queue-container using hx-swap-oob="innerHTML",
// along with #queue-count so the header counter stays synchronized across all clients.
templ QueueOOB(state room.RoomSnapshot) {
	<ol id="queue-container" hx-swap-oob="innerHTML">
		@QueueItems(state)
	</ol>
	<h4 id="queue-count" hx-swap-oob="outerHTML" class="text-xs font-medium text-slate-400">
		{ strconv.Itoa(state.QueueCurrent) }/{ strconv.Itoa(state.QueueTotal) } canciones
	</h4>
}

// RoomPlaybackOOB updates only the sync beacon and transport controls (used for 1.5s Host time ticks
// so #queue-container is never unnecessarily re-rendered while users interact with or reorder the queue).
templ RoomPlaybackOOB(state room.RoomSnapshot) {
	@SyncMeta(state, true)
	@Controls(state, true)
}

// RoomBroadcastOOB combines SyncMeta, Controls, and QueueOOB into a single atomic SSE OOB payload.
templ RoomBroadcastOOB(state room.RoomSnapshot) {
	@SyncMeta(state, true)
	@Controls(state, true)
	@QueueOOB(state)
}
