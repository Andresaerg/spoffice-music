package components

import (
	"fmt"
	"time"

	"github.com/lmf3z/smlf/internal/room"
)

func formatElapsed(d time.Duration) string {
	totalSec := int(d.Seconds())
	if totalSec < 0 {
		totalSec = 0
	}
	mins := totalSec / 60
	secs := totalSec % 60
	return fmt.Sprintf("%02d:%02d", mins, secs)
}

func progressPercent(state room.RoomSnapshot) string {
	if state.CurrentTrack == nil || state.CurrentTrack.Duration <= 0 {
		if state.Status == room.StatusPlaying {
			return "100"
		}
		return "0"
	}
	pct := (state.Elapsed.Seconds() / state.CurrentTrack.Duration.Seconds()) * 100
	if pct < 0 {
		pct = 0
	}
	if pct > 100 {
		pct = 100
	}
	return fmt.Sprintf("%.1f", pct)
}

// Controls renders a YouTube Music-inspired transport & metadata bar (#player-controls-bar).
// Updated out-of-band without touching the video iframe DOM node.
templ Controls(state room.RoomSnapshot, oob bool) {
	<div
		id="player-controls-bar"
		if oob {
			hx-swap-oob="outerHTML"
		}
		class="relative mt-2.5 overflow-hidden rounded-xl border border-white/10 bg-[#181818]/95 px-3 py-2.5 shadow-2xl backdrop-blur-md sm:mt-3 sm:px-4 sm:py-3"
	>
		<!-- YouTube Music Signature Top Red Progress Line -->
		<div class="absolute top-0 right-0 left-0 h-1 bg-white/10">
			<div
				class="h-full bg-gradient-to-r from-red-600 to-rose-500 transition-all duration-500"
				style={ "width: " + progressPercent(state) + "%" }
			></div>
		</div>

		<div class="flex items-center justify-between gap-2.5 pt-0.5 sm:gap-4">
			<!-- Left Cluster: YT Music Transport Controls + Timecode -->
			<div class="flex shrink-0 items-center gap-2 sm:gap-3">
				if state.Status == room.StatusPlaying {
					<button
						type="button"
						hx-post="/room/pause"
						hx-swap="none"
						class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full bg-white text-black shadow-lg transition-all hover:scale-105 hover:bg-slate-200 active:scale-95 sm:size-10"
						title="Pausar reproducción en toda la sala"
						aria-label="Pausar"
					>
						<svg class="size-5 fill-current" viewBox="0 0 24 24">
							<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path>
						</svg>
					</button>
				} else {
					<button
						type="button"
						hx-post="/room/play"
						hx-swap="none"
						class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full bg-red-600 text-white shadow-lg shadow-red-600/30 transition-all hover:scale-105 hover:bg-red-500 active:scale-95 disabled:opacity-40 sm:size-10"
						disabled?={ state.CurrentTrack == nil && len(state.Queue) == 0 }
						title="Reproducir en toda la sala"
						aria-label="Reproducir"
					>
						<svg class="size-5 fill-current" viewBox="0 0 24 24">
							<path d="M8 5v14l11-7z"></path>
						</svg>
					</button>
				}

				<button
					id="skip-song-btn"
					type="button"
					hx-post="/room/skip"
					hx-swap="none"
					class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-white/10 bg-white/5 p-2 text-xs font-semibold text-slate-200 transition-all hover:border-white/20 hover:bg-white/15 hover:text-white disabled:opacity-40 sm:px-3.5 sm:py-2"
					disabled?={ state.CurrentTrack == nil && len(state.Queue) == 0 }
					title="Saltar a la siguiente canción"
				>
					<svg class="size-4 fill-current" viewBox="0 0 24 24">
						<path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"></path>
					</svg>
					<span class="hidden sm:inline">Siguiente</span>
				</button>

				if state.CurrentTrack != nil {
					<span class="hidden font-mono text-xs text-slate-400 sm:inline">
						{ formatElapsed(state.Elapsed) }
						if state.CurrentTrack.Duration > 0 {
							{ " / " + formatElapsed(state.CurrentTrack.Duration) }
						}
					</span>
				}
			</div>

			<!-- Center/Right Cluster: Active Track Artwork & Metadata (YT Music style) -->
			<div class="flex min-w-0 flex-1 items-center justify-end gap-2.5 sm:gap-3">
				if state.CurrentTrack != nil {
					<div class="relative shrink-0">
						if state.CurrentTrack.ThumbnailURL != "" {
							<img
								src={ state.CurrentTrack.ThumbnailURL }
								alt=""
								class="size-10 rounded-md object-cover shadow-md ring-1 ring-white/15 sm:size-11"
							/>
						}
					</div>
					<div class="min-w-0 flex-1">
						<div class="flex items-center gap-2">
							<p
								id="now-playing"
								class="truncate text-xs font-semibold text-white sm:text-base"
								title={ state.CurrentTrack.Title }
								aria-live="polite"
							>
								{ state.CurrentTrack.Title }
							</p>
						</div>
						<div class="mt-0.5 flex flex-wrap items-center gap-1.5 sm:gap-2">
							if state.Status == room.StatusPlaying {
								<span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/15 px-2 py-0.5 text-[10px] font-bold tracking-wider text-emerald-400 uppercase ring-1 ring-emerald-500/30">
									<span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
									PLAYING
								</span>
							} else {
								<span class="inline-flex items-center gap-1 rounded-full bg-amber-500/15 px-2 py-0.5 text-[10px] font-bold tracking-wider text-amber-300 uppercase ring-1 ring-amber-500/30">
									<span class="size-1.5 rounded-full bg-amber-400"></span>
									PAUSED
								</span>
							}
							<span class="font-mono text-[11px] text-slate-400 sm:hidden">
								{ formatElapsed(state.Elapsed) }
								if state.CurrentTrack.Duration > 0 {
									{ " / " + formatElapsed(state.CurrentTrack.Duration) }
								}
							</span>
							if state.CurrentTrack.Author != "" {
								<span class="hidden truncate text-xs text-slate-400 sm:inline">{ state.CurrentTrack.Author }</span>
							}
						</div>
					</div>
				} else {
					<div class="flex min-w-0 flex-1 items-center gap-3">
						<div class="flex size-11 shrink-0 items-center justify-center rounded-md bg-white/5 ring-1 ring-white/10">
							<svg class="size-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path>
							</svg>
						</div>
						<div class="min-w-0 flex-1">
							<p id="now-playing" class="truncate text-sm font-semibold text-slate-300" aria-live="polite">
								No hay canciones en la lista.
							</p>
							<span class="text-xs text-slate-500">Agrega canciones o genera un mix aleatorio</span>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
	if oob {
		<span id="mini-now-playing" hx-swap-oob="outerHTML" class="truncate text-xs font-semibold text-white">
			if state.CurrentTrack != nil {
				{ state.CurrentTrack.Title }
			} else {
				Sin reproducción
			}
		</span>
	}
}
