package components

import (
	"strconv"

	"github.com/lmf3z/smlf/cmd/models"
	"github.com/lmf3z/smlf/internal/room"
)

type PageViewModel struct {
	InvidiousVersion string
	SoftwareVersion  string
	Subtitle         string
	CurrentPage      string
	InvidiousHost    string
	Songs            []models.YTSong
	PreloadTag       string
	Room             room.RoomSnapshot
}

func gridClassForPage(page string) string {
	if page == "list" {
		return "contents"
	}
	return "grid flex-1 grid-cols-[minmax(0,1fr)] gap-4 lg:h-[calc(100vh-8.5rem)] lg:min-h-[32rem] lg:grid-cols-[minmax(0,2.1fr)_minmax(22rem,1fr)] lg:gap-6"
}

func playerSectionClass(page string) string {
	if page == "list" {
		return "fixed inset-x-3 bottom-3 z-50 sm:left-auto sm:right-5 sm:bottom-5 sm:w-96 rounded-xl border border-white/20 bg-[#181818]/95 shadow-2xl shadow-black/90 backdrop-blur-md overflow-hidden ring-1 ring-black/50 transition-all duration-300 group"
	}
	return "flex min-h-0 flex-col min-w-0 transition-all duration-300"
}

templ IndexPage(vm PageViewModel) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Rockita Music · Office Jukebox</title>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script
				src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js"
				integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V"
				crossorigin="anonymous"
			></script>
			<script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.3/sse.js" crossorigin="anonymous"></script>
			<script defer src="/static/js/player_sync.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js" crossorigin="anonymous"></script>
			<link rel="icon" type="image/png" href="/yt-music-lite-rmbg.png"/>
			<link rel="shortcut icon" type="image/png" href="/yt-music-lite-rmbg.png"/>
			<style>
				.htmx-indicator {
					display: none;
				}
				.htmx-request.htmx-indicator {
					display: flex;
				}
			</style>
		</head>
		<body class="min-h-screen bg-[#030303] text-white selection:bg-red-600 selection:text-white">
			<main
				x-data="playerSync()"
				hx-ext="sse"
				sse-connect="/room/events"
				class="mx-auto flex min-h-screen w-full max-w-[1800px] overflow-x-hidden flex-col px-3 py-3 sm:px-6 sm:py-4 lg:px-8"
			>
				<!-- Hidden SSE sink that processes OOB swaps broadcast from the Go Hub -->
				<div sse-swap="room-sync" class="hidden" aria-hidden="true"></div>

				<!-- Invisible OOB State Beacon (#player-sync-trigger) -->
				@SyncMeta(vm.Room, false)

				@Header(vm)
				@Toast()
				@SearchView(vm)

				<!-- Player & Queue Grid View -->
				<div id="player-grid-view" class={ gridClassForPage(vm.CurrentPage) }>
					@PlayerSection(vm)
					@QueueSection(vm)
				</div>
			</main>

			@PasteLinkModal()

			<div
				id="app-config"
				data-current-page={ vm.CurrentPage }
				data-invidious-host={ vm.InvidiousHost }
				class="hidden"
			></div>

			<script src="/static/js/player.js"></script>
			<script src="/static/js/queue.js"></script>
			<script src="/static/js/search.js"></script>
			<script src="/static/js/app.js"></script>
		</body>
	</html>
}

templ Header(vm PageViewModel) {
	<header class="mb-4 flex shrink-0 flex-col gap-3 border-b border-white/10 pb-3.5 sm:mb-5 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-4">
		<div class="flex w-full items-center justify-between gap-2 sm:w-auto sm:flex-wrap sm:justify-start sm:gap-3">
			<!-- YT Music Brand Emblem -->
			<a id="brand-link" href="/" class="group flex min-w-0 cursor-pointer items-center gap-2.5">
				/* <span class="flex size-8 items-center justify-center rounded-full bg-red-600 shadow-md shadow-red-600/30 transition-transform group-hover:scale-105">
					<svg class="size-4 translate-x-0.5 fill-white" viewBox="0 0 24 24">
						<path d="M8 5v14l11-7z"></path>
					</svg>
				</span> */
				<img src="/yt-music-lite-rmbg.png" alt="Rockita Music" class="size-8 shrink-0" />
				<div class="min-w-0">
					<div class="flex items-center gap-2">
						<h1 class="truncate text-lg font-bold tracking-tight text-white sm:text-xl">Rockita <span class="font-normal text-slate-300">Music</span></h1>
					</div>
					<p id="header-subtitle" class="truncate text-[11px] text-slate-400 sm:text-xs">
						if vm.Subtitle != "" {
							{ vm.Subtitle }
						} else {
							Lista de reproducción · canciones de hoy
						}
					</p>
				</div>
			</a>

			<!-- Read-Only Host vs Remote Role Status Badge -->
			<span
				role="status"
				class="inline-flex shrink-0 cursor-default items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-semibold select-none sm:px-3 sm:text-xs"
				:class="isHost ? 'border-emerald-500/40 bg-emerald-500/15 text-emerald-300 shadow-sm shadow-emerald-500/10' : 'border-white/15 bg-white/5 text-slate-300'"
				:title="isHost ? 'Equipo principal de la oficina (salida de audio activa)' : 'Dispositivo en red local (audio silenciado, control colaborativo)'"
			>
				<template x-if="isHost">
					<svg class="size-3.5 shrink-0 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
						<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"></path>
					</svg>
				</template>
				<template x-if="!isHost">
					<svg class="size-3.5 shrink-0 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
						<path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"></path>
					</svg>
				</template>
				<span class="sm:hidden" x-text="isHost ? 'Host · Audio' : 'Remoto'">Remoto</span>
				<span class="hidden sm:inline" x-text="isHost ? 'Modo Host · Audio Activo' : 'Modo Remoto · Silenciado'">Modo Remoto</span>
			</span>

			if vm.InvidiousVersion != "" || vm.SoftwareVersion != "" {
				<span class="hidden rounded-full border border-white/10 bg-white/[0.03] px-2.5 py-0.5 text-[11px] text-slate-500 xl:inline-block">
					Invidious ({ vm.InvidiousVersion } - { vm.SoftwareVersion })
				</span>
			}
		</div>

		<!-- Header Action Pills with Icons -->
		<div class="grid w-full grid-cols-2 items-center gap-2 sm:flex sm:w-auto sm:flex-wrap sm:gap-2.5">
			<button
				id="open-paste-link"
				type="button"
				class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-2 text-xs font-semibold text-slate-200 transition-all hover:border-white/25 hover:bg-white/10 hover:text-white sm:px-4 sm:text-sm"
				title="Pegar un enlace directo de YouTube"
			>
				<svg class="size-4 shrink-0 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
				</svg>
				<span>Pegar link</span>
			</button>

			if vm.CurrentPage == "list" {
				<a
					id="view-toggle-btn"
					href="/"
					class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-black shadow transition-all hover:bg-slate-200 sm:px-4 sm:text-sm"
				>
					<svg class="size-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
						<path d="M8 5v14l11-7z"></path>
					</svg>
					<span id="view-toggle-label">Abrir reproductor</span>
				</a>
			} else {
				<a
					id="view-toggle-btn"
					href="/list"
					class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-black shadow transition-all hover:bg-slate-200 sm:px-4 sm:text-sm"
				>
					<svg class="size-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<span id="view-toggle-label">Buscar canciones</span>
				</a>
			}
		</div>
	</header>
}

templ Toast() {
	<div
		id="toast"
		role="status"
		aria-live="polite"
		class="fixed top-5 right-5 z-[100] hidden cursor-pointer rounded-xl bg-emerald-600 px-4 py-3 text-sm font-medium text-white shadow-2xl transition-all duration-300 select-none"
		onclick="this.classList.add('hidden')"
	></div>
}

templ SearchView(vm PageViewModel) {
	<div
		id="search-view"
		if vm.CurrentPage == "list" {
			class="mb-8 flex flex-1 flex-col"
		} else {
			class="mb-8 hidden flex-1 flex-col"
		}
	>
		<!-- YouTube Music Inspired Search Bar -->
		<div class="relative mx-auto mb-8 w-full max-w-2xl">
			<form
				id="search-form"
				hx-get="/search"
				hx-target="#search-results"
				hx-swap="innerHTML"
				hx-indicator="#search-loading"
				hx-sync="this:drop"
				hx-disabled-elt="find button"
				class="flex w-full items-center gap-2.5"
			>
				<div class="relative flex-1">
					<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400">
						<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</span>
					<input
						id="search-input"
						type="text"
						name="query"
						placeholder="Buscar canciones, álbumes o artistas..."
						autocomplete="off"
						class="w-full rounded-full border border-white/15 bg-[#1d1d1d] py-2.5 pr-4 pl-10 text-sm text-white placeholder:text-slate-400 focus:border-white/40 focus:bg-[#242424] focus:outline-none"
					/>
					<ul
						id="suggestions-dropdown"
						class="absolute top-full right-0 left-0 z-50 mt-2 hidden max-h-72 divide-y divide-white/5 overflow-y-auto rounded-xl border border-white/10 bg-[#1d1d1d] shadow-2xl backdrop-blur-md"
					></ul>
				</div>

				<button
					type="submit"
					class="inline-flex cursor-pointer items-center gap-2 rounded-full bg-red-600 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-red-600/20 transition-all hover:bg-red-500 disabled:cursor-not-allowed disabled:opacity-50"
				>
					<svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<span>Buscar</span>
				</button>
			</form>
		</div>

		<div id="search-loading" class="htmx-indicator mb-4 flex items-center justify-center">
			<svg class="mr-3 size-5 animate-spin" width="100" height="100" viewBox="0 0 100 100">
				<circle class="spinner" cx="50" cy="50" r="40" fill="none" stroke="#ef4444" stroke-width="8" stroke-dasharray="150"></circle>
			</svg>
		</div>

		<div class="mb-4 flex items-center justify-between">
			<h2 id="results-title" class="text-base font-bold tracking-tight text-white">
				if len(vm.Songs) > 0 {
					if vm.PreloadTag == "biblioteca" {
						Biblioteca guardada
					} else if vm.PreloadTag != "" {
						{ "Tendencias (#" + vm.PreloadTag + ")" }
					} else {
						Tendencias (#rock)
					}
				}
			</h2>
		</div>

		<ul id="search-results" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			if len(vm.Songs) > 0 {
				@SearchResultsList(vm.Songs)
			}
		</ul>
	</div>
}

templ PlayerSection(vm PageViewModel) {
	<section id="player-section" class={ playerSectionClass(vm.CurrentPage) } aria-label="Reproductor">
		<!-- Mini Player Header (visible in mini mode) -->
		<div
			id="mini-player-header"
			if vm.CurrentPage == "list" {
				class="flex items-center justify-between gap-2 border-b border-white/10 bg-[#141414] px-3 py-2"
			} else {
				class="hidden flex items-center justify-between gap-2 border-b border-white/10 bg-[#141414] px-3 py-2"
			}
		>
			<div class="flex min-w-0 items-center gap-2">
				<span class="size-2 shrink-0 animate-pulse rounded-full bg-red-500"></span>
				<span id="mini-now-playing" class="truncate text-xs font-semibold text-white">
					if vm.Room.CurrentTrack != nil {
						{ vm.Room.CurrentTrack.Title }
					} else {
						Sin reproducción
					}
				</span>
			</div>
			<div class="flex shrink-0 items-center gap-1.5">
				<button
					id="mini-skip-btn"
					type="button"
					hx-post="/room/skip"
					hx-swap="none"
					class="cursor-pointer rounded-full p-1.5 text-slate-400 transition-colors hover:bg-white/10 hover:text-white"
					title="Saltar a la siguiente canción"
				>
					<svg class="size-4 fill-current" viewBox="0 0 24 24">
						<path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"></path>
					</svg>
				</button>
				<button
					id="mini-expand-btn"
					type="button"
					class="flex cursor-pointer items-center gap-1 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-black transition-colors hover:bg-slate-200"
					title="Expandir reproductor completo"
				>
					<svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
					</svg>
					<span>Abrir</span>
				</button>
			</div>
		</div>

		<!-- Full Player Header (hidden in mini mode) -->
		<div
			id="full-player-header"
			if vm.CurrentPage == "list" {
				class="mb-2.5 hidden shrink-0 items-center justify-between gap-3"
			} else {
				class="mb-2.5 flex shrink-0 items-center justify-between gap-3"
			}
		>
			<div class="flex items-center gap-2">
				<span class="text-[11px] font-bold tracking-wider text-slate-400 uppercase">Fuente:</span>
				<div class="inline-flex rounded-full border border-white/15 bg-white/5 p-0.5 text-xs">
					<button
						id="engine-yt-btn"
						type="button"
						class="flex cursor-pointer items-center gap-1.5 rounded-full bg-red-600 px-3 py-1 font-semibold text-white shadow transition-all"
						title="Usar reproductor oficial de YouTube"
					>
						<svg class="size-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
						</svg>
						YouTube
					</button>
					<button
						id="engine-invidious-btn"
						type="button"
						class="flex cursor-pointer items-center gap-1.5 rounded-full px-3 py-1 font-semibold text-slate-400 transition-all hover:text-white"
						title="Usar reproductor Invidious (solo el Host puede cambiar)"
					>
						<svg class="size-3.5 fill-current" viewBox="0 0 24 24">
							<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"></path>
						</svg>
						Invidious
					</button>
				</div>
				<span id="player-engine-badge" class="hidden text-xs text-slate-500 sm:inline-block"></span>
			</div>
		</div>

		<!-- CRITICAL INVARIANT: Static Video Container (#player-viewport) is NEVER swapped by HTMX -->
		<div
			id="player-viewport"
			tabindex="0"
			aria-label="Área de video del reproductor."
			class="relative aspect-video overflow-hidden rounded-xl border border-white/10 bg-black shadow-2xl shadow-black/60 focus:ring-2 focus:ring-red-600 focus:outline-none"
		>
			<div id="youtube-wrapper" class="h-full w-full">
				<div id="player" class="h-full w-full"></div>
			</div>
			<iframe
				id="invidious-iframe"
				class="hidden h-full w-full border-0"
				allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
				allowfullscreen
			></iframe>
		</div>

		<!-- Synchronized YT Music Controls & Active Track Metadata (Swapped via OOB) -->
		<div
			id="full-player-footer"
			if vm.CurrentPage == "list" {
				class="hidden"
			}
		>
			@Controls(vm.Room, false)
		</div>
	</section>
}

templ QueueSection(vm PageViewModel) {
	<section
		id="queue-section"
		if vm.CurrentPage == "list" {
			class="hidden flex min-h-0 min-w-0 w-full flex-col"
		} else {
			class="flex min-h-0 min-w-0 w-full flex-col"
		}
		aria-labelledby="queue-heading"
	>
		<!-- YouTube Music "A CONTINUACIÓN" Tab Header + Action Pills -->
		<div class="mb-2.5 flex shrink-0 flex-col gap-2.5 sm:mb-3 sm:gap-3">
			<div class="flex items-center justify-between gap-2 border-b border-white/10 pb-2">
				<div class="flex min-w-0 items-center gap-4">
					<h2
						id="queue-heading"
						class="relative truncate text-xs font-bold tracking-widest text-white uppercase after:absolute after:right-0 after:-bottom-[9px] after:left-0 after:h-0.5 after:bg-white"
					>
						A continuación
					</h2>
				</div>
				<div class="flex shrink-0 items-center gap-1.5 text-xs text-slate-400">
					<span class="hidden sm:inline">Cola de hoy ·</span>
					<h4 id="queue-count" class="text-xs font-medium text-slate-400">
						{ strconv.Itoa(vm.Room.QueueCurrent) }/{ strconv.Itoa(vm.Room.QueueTotal) } canciones
					</h4>
				</div>
			</div>

			<!-- YT Music Pill Toolbar with Responsive Mobile Chips -->
			<div class="flex flex-wrap items-center justify-between gap-1.5 py-0.5 sm:gap-2 [&>button]:cursor-pointer">
				<div class="flex flex-wrap items-center gap-1 sm:gap-1.5">
					<button
						id="shuffle-queue"
						type="button"
						class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-white/15 bg-white/[0.06] px-2.5 py-1.5 text-[11px] font-medium text-slate-200 transition-all hover:border-white/25 hover:bg-white/15 hover:text-white sm:gap-1.5 sm:px-3 sm:text-xs"
						title="Mezclar aleatoriamente las canciones de la cola"
					>
						<svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path>
						</svg>
						<span>Mezclar</span>
					</button>

					<button
						id="reorder-queue"
						type="button"
						class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-white/15 bg-white/[0.06] px-2.5 py-1.5 text-[11px] font-medium text-slate-200 transition-all hover:border-white/25 hover:bg-white/15 hover:text-white sm:gap-1.5 sm:px-3 sm:text-xs"
						title="Reordenar canciones arrastrándolas"
					>
						<svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
						</svg>
						<span id="reorder-queue-label">Reordenar</span>
					</button>

					<button
						id="refresh-queue"
						type="button"
						class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.06] p-1.5 text-[11px] font-medium text-slate-200 transition-all hover:border-white/25 hover:bg-white/15 hover:text-white sm:px-3 sm:py-1.5 sm:text-xs"
						title="Actualizar cola"
						aria-label="Actualizar cola"
					>
						<svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
						</svg>
						<span class="hidden sm:inline">Actualizar</span>
					</button>

					<button
						id="clear-played-queue"
						type="button"
						class="inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.06] p-1.5 text-[11px] font-medium text-slate-200 transition-all hover:border-white/25 hover:bg-white/15 hover:text-white sm:px-3 sm:py-1.5 sm:text-xs"
						title="Limpiar canciones ya reproducidas de la cola"
						aria-label="Limpiar canciones ya reproducidas"
					>
						<svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
						<span class="hidden sm:inline">Limpiar</span>
					</button>
				</div>

				<button
					id="random-queue"
					type="button"
					class="inline-flex shrink-0 cursor-pointer items-center gap-1 rounded-full bg-white px-2.5 py-1.5 text-[11px] font-semibold text-black shadow transition-all hover:bg-slate-200 disabled:cursor-wait disabled:opacity-60 sm:gap-1.5 sm:px-3.5 sm:text-xs"
					title="Agregar 5 canciones aleatorias no reproducidas al mix de hoy"
				>
					<svg class="size-3.5 shrink-0 text-red-600" fill="currentColor" viewBox="0 0 24 24">
						<path d="M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z"></path>
					</svg>
					<span>+5 Mix</span>
				</button>
			</div>
		</div>

		<p id="random-queue-status" class="hidden min-h-4 text-xs text-slate-400" aria-live="polite"></p>
		<ol
			id="queue-container"
			class="scrollbar-thin scrollbar-thumb-slate-600 max-h-[26rem] min-h-[16rem] flex-1 divide-y divide-white/[0.06] overflow-y-auto overscroll-contain rounded-xl border border-white/10 bg-[#121212] lg:max-h-[calc(100dvh-15rem)] lg:min-h-0"
			aria-live="polite"
		>
			@QueueItems(vm.Room)
		</ol>
	</section>
}

templ PasteLinkModal() {
	<dialog id="paste-link-dialog" class="w-[min(92vw,32rem)] rounded-2xl border border-white/15 bg-[#181818] p-0 text-white shadow-2xl backdrop:bg-black/75">
		<form id="paste-link-form" class="grid gap-4 p-6">
			<div class="flex items-start justify-between gap-4">
				<div>
					<h2 class="text-lg font-semibold">Agregar enlace de YouTube</h2>
					<p class="mt-1 text-sm text-slate-400">El video se agregará a la lista sin usar llamadas a la API.</p>
				</div>
				<button id="close-paste-link" type="button" aria-label="Cerrar" class="cursor-pointer rounded-full p-1.5 text-slate-400 hover:bg-white/10 hover:text-white">✕</button>
			</div>
			<label for="youtube-link-input" class="grid gap-2 text-sm font-medium">
				Enlace del video
				<input
					id="youtube-link-input"
					name="url"
					type="url"
					required
					autocomplete="off"
					placeholder="https://youtu.be/eSaa3vC_n2k"
					class="w-full rounded-xl border border-white/15 bg-[#0f0f0f] p-3 text-white placeholder:text-slate-500 focus:border-red-600 focus:outline-none"
				/>
			</label>
			<label id="youtube-title-field" for="youtube-title-input" class="hidden gap-2 text-sm font-medium">
				Nombre del video
				<input
					id="youtube-title-input"
					name="title"
					type="text"
					maxlength="200"
					autocomplete="off"
					placeholder="Escribe el título para identificar la canción"
					class="w-full rounded-xl border border-white/15 bg-[#0f0f0f] p-3 text-white placeholder:text-slate-500 focus:border-red-600 focus:outline-none"
				/>
			</label>
			<p id="paste-link-status" role="status" aria-live="polite" class="min-h-5 text-sm text-slate-400"></p>
			<button
				id="submit-paste-link"
				type="submit"
				class="cursor-pointer rounded-full bg-red-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-red-500 disabled:cursor-wait disabled:opacity-60"
			>
				Agregar a la lista
			</button>
		</form>
	</dialog>
	<div id="paste-link-toast" role="status" aria-live="polite" class="fixed right-5 bottom-5 z-50 hidden rounded-xl bg-emerald-700 px-4 py-3 text-sm text-white shadow-lg"></div>
	<script>
		(() => {
			const dialog = document.querySelector('#paste-link-dialog');
			const form = document.querySelector('#paste-link-form');
			const input = document.querySelector('#youtube-link-input');
			const titleField = document.querySelector('#youtube-title-field');
			const titleInput = document.querySelector('#youtube-title-input');
			const status = document.querySelector('#paste-link-status');
			const submitButton = document.querySelector('#submit-paste-link');
			const toast = document.querySelector('#paste-link-toast');
			let toastTimeout;

			document.querySelector('#open-paste-link')?.addEventListener('click', async () => {
				input.value = '';
				titleInput.value = '';
				titleInput.required = false;
				titleField.classList.add('hidden');
				titleField.classList.remove('grid');
				status.textContent = 'Intentando leer el portapapeles…';
				dialog.showModal();
				input.focus();

				if (!navigator.clipboard?.readText) {
					status.textContent = 'No se puede leer el portapapeles desde este contexto. Pega o escribe el enlace.';
					return;
				}

				try {
					const clipboardText = await navigator.clipboard.readText();
					if (clipboardText.trim()) {
						input.value = clipboardText.trim();
						status.textContent = 'Enlace leído del portapapeles. Confírmalo y agrégalo.';
					} else {
						status.textContent = 'El portapapeles está vacío. Pega o escribe el enlace.';
					}
				} catch {
					status.textContent = 'No se pudo acceder al portapapeles. Pega o escribe el enlace manualmente.';
				}
			});

			document.querySelector('#close-paste-link')?.addEventListener('click', () => dialog.close());
			input?.addEventListener('input', () => {
				status.textContent = '';
			});

			form?.addEventListener('submit', async event => {
				event.preventDefault();
				submitButton.disabled = true;
				status.textContent = 'Agregando el video…';

				try {
					const response = await fetch('/add-youtube-link', {
						method: 'POST',
						headers: {'Content-Type': 'application/json'},
						body: JSON.stringify({url: input.value.trim(), title: titleInput.value.trim()})
					});
					const responseText = await response.text();
					let result;
					try {
						result = JSON.parse(responseText);
					} catch {
						throw new Error(responseText.trim() || 'No se pudo agregar el enlace.');
					}
					if (response.status === 422 && result.needs_title) {
						titleField.classList.remove('hidden');
						titleField.classList.add('grid');
						titleInput.required = true;
						status.textContent = result.message;
						titleInput.focus();
						return;
					}
					if (!response.ok) throw new Error(result.error || responseText.trim());

					dialog.close();
					toast.textContent = result.message;
					toast.classList.remove('hidden');
					clearTimeout(toastTimeout);
					toastTimeout = setTimeout(() => toast.classList.add('hidden'), 5000);
					document.dispatchEvent(new CustomEvent('youtube-link-added', {detail: {added: result.added}}));
				} catch (error) {
					status.textContent = error.message || 'No se pudo agregar el enlace.';
				} finally {
					submitButton.disabled = false;
				}
			});
		})();
	</script>
}
